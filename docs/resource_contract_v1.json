    "evaluation": {
      "metrics": [
        {
          "definition": "已完成任务数 / (已完成 + 过期 + 主动放弃 + 执行器拒绝 + 长期未获服务)。分母与被冻结的任务完成口径一致，**主动放弃不缩小分母**。",
          "direction": "higher",
          "key": "service_completion",
          "name_cn": "服务完成度",
          "scale": 1.0,
          "unit": "比值"
        },
        {
          "definition": "截止时间前完成的任务数 / 已完成任务数；没有已完成任务时记 0。只统计**真的完成**的任务，因此它回答「做成的那些及时吗」，与完成度互补、不可互相替代。",
          "direction": "higher",
          "key": "task_timeliness",
          "name_cn": "任务及时性",
          "scale": 1.0,
          "unit": "比值"
        },
        {
          "definition": "1 / (1 + 可见航迹的平均信息年龄)。取值落在 (0,1]，年龄 0 时为 1。用这个形式是为了避免「年龄无上界」导致量纲失控；**这个函数形式是声明的约定，不是拟合出来的**。",
          "direction": "higher",
          "key": "estimate_quality",
          "name_cn": "估计质量",
          "scale": 1.0,
          "unit": "1/(1+秒)"
        },
        {
          "definition": "对三类预算单位各算 consumed/capacity，再取算术平均。逐单位的明细必须一并给出（见 per_unit），避免「平均」把某一类单位吃穿的事实掩盖掉。",
          "direction": "lower",
          "key": "resource_consumption",
          "name_cn": "资源消耗",
          "scale": 1.0,
          "unit": "容量占比"
        },
        {
          "definition": "通信字节的实际消耗总量（来自账本，不从计划反推）。",
          "direction": "lower",
          "key": "communication_overhead",
          "name_cn": "通信开销",
          "scale": 1024.0,
          "unit": "字节"
        },
        {
          "definition": "本方法在该次运行中花在**规划**上的墙钟时间总和（不含执行、不含仿真推进）。它是优化参考的**代价项**，必须与收益一起报告。",
          "direction": "lower",
          "key": "compute_time",
          "name_cn": "计算耗时",
          "scale": 1.0,
          "unit": "秒"
        }
      ],
      "objective_default": {
        "compute_time_weight_is_zero_reason": "同一次规划内所有候选的计算耗时相同，对候选排序无区分能力；它仍作为独立维度记录与对照。",
        "normalize": {
          "communication_overhead": 1024.0,
          "compute_time": 1.0,
          "estimate_quality": 1.0,
          "resource_consumption": 1.0,
          "service_completion": 1.0,
          "task_timeliness": 1.0
        },
        "note": "这是**声明的偏好**，不是「唯一正确的目标」；换一组权重就会换一个最优解。综合分只用于搜索内部排序，报告一律给 6 维向量。",
        "weights": {
          "communication_overhead": -0.2,
          "compute_time": 0.0,
          "estimate_quality": 0.5,
          "resource_consumption": -0.3,
          "service_completion": 1.0,
          "task_timeliness": 0.5
        }
      },
      "rule": "评价一律给完整向量；综合分只是搜索内部的**声明式偏好**，不得作为「方法好不好」的结论"
    },
