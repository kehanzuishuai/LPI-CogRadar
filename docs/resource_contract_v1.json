    "completion_semantics": {
      "abandon_definition": "等待超过 abandon_after_s 且该节点仍无法服务；状态置 cancelled，任务保留在队列中",
      "completion_rate_denominator": "完成 + 过期 + 主动放弃 + 执行器拒绝 + 长期未获服务",
      "duplicate_definition": "同 task_id / 同去重键已成功执行过 → 计划级致命拒绝；同一 (kind, targets) 在多个节点出现由配置规则决定",
      "expiry_definition": "now > deadline_s 且未完成/未取消",
      "no_deletion_rule": "任何失败/放弃/过期都**不得**从队列中删除任务——删掉难任务只会让完成率下降，不可能把它做高",
      "starvation_definition": "等待超过 starvation_threshold_s，且**不是**因截止时间到期而离开队列；与'过期'互斥",
      "status_cn": {
        "cancelled": "主动放弃（**仍在队列**，分母不变）",
        "completed": "完成（计入分子）",
        "expired": "过期（**不删除**，仍计入分母）",
        "pending": "待释放（未到释放时间）",
        "rejected": "被执行器拒绝",
        "released": "已释放",
        "submitted": "已排入计划"
      },
      "task_statuses": [
        "pending",
